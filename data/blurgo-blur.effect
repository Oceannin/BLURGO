uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 direction;
uniform float2 texture_size;
uniform float pixel_size;

sampler_state linear_clamp {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state point_clamp {
	Filter = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = vert_in.uv;
	return vert_out;
}

float4 PSGaussian(VertData vert_in) : TARGET
{
	float4 color = image.Sample(linear_clamp, vert_in.uv) * 0.2270270270;
	color += image.Sample(linear_clamp, vert_in.uv + direction * 1.3846153846) * 0.3162162162;
	color += image.Sample(linear_clamp, vert_in.uv - direction * 1.3846153846) * 0.3162162162;
	color += image.Sample(linear_clamp, vert_in.uv + direction * 3.2307692308) * 0.0702702703;
	color += image.Sample(linear_clamp, vert_in.uv - direction * 3.2307692308) * 0.0702702703;
	return color;
}

float4 PSBox(VertData vert_in) : TARGET
{
	float4 color = image.Sample(linear_clamp, vert_in.uv - direction * 4.0);
	color += image.Sample(linear_clamp, vert_in.uv - direction * 3.0);
	color += image.Sample(linear_clamp, vert_in.uv - direction * 2.0);
	color += image.Sample(linear_clamp, vert_in.uv - direction);
	color += image.Sample(linear_clamp, vert_in.uv);
	color += image.Sample(linear_clamp, vert_in.uv + direction);
	color += image.Sample(linear_clamp, vert_in.uv + direction * 2.0);
	color += image.Sample(linear_clamp, vert_in.uv + direction * 3.0);
	color += image.Sample(linear_clamp, vert_in.uv + direction * 4.0);
	return color / 9.0;
}

float4 PSPixelate(VertData vert_in) : TARGET
{
	float2 safe_texture_size = max(texture_size, float2(1.0, 1.0));
	float2 block_uv = max(float2(pixel_size, pixel_size) / safe_texture_size,
			      float2(1.0, 1.0) / safe_texture_size);
	float2 sample_uv = (floor(vert_in.uv / block_uv) + 0.5) * block_uv;
	return image.Sample(point_clamp, sample_uv);
}

technique Gaussian
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader = PSGaussian(vert_in);
	}
}

technique Box
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader = PSBox(vert_in);
	}
}

technique Pixelate
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader = PSPixelate(vert_in);
	}
}
